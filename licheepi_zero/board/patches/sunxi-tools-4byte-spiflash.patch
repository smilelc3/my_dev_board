 /*****************************************************************************/
+/*
+ * 本地补丁：32 MiB SPI NOR（Macronix MX25L25645G）的 4 字节地址支持
+ *
+ * 上游 sunxi-fel 的 spiflash 读写只发 3 字节地址（24 bit = 16 MiB），
+ * 超过 16 MiB 会静默回绕、覆盖前面的数据（Sipeed 的 wiki 也讲了这个问题，
+ * 他们的做法是照 U-Boot 的 CONFIG_SPI_FLASH_BAR，用 WREAR(0xC5) 切 bank）。
+ *
+ * 这里改成用"专用 4 字节 opcode"：0x13(4READ) / 0x12(4PP) / 0x21(4SE) / 0xDC(4BE)。
+ * 好处是这些命令自带 4 字节地址，**不改变芯片任何状态** —— 既不用 EN4B(0xB7)
+ * 也不用写 EAR/bank 寄存器，所以烧完复位后 BROM 用 3 字节地址照样能读到偏移 0 的
+ * eGON 头，不会出现"必须断电才能恢复"的情况（内核/U-Boot 里我们也是这么做的）。
+ */
+#define SPI_FLASH_16MB 0x1000000
+
+static uint8_t opcode_4b(uint8_t cmd)
+{
+	switch (cmd) {
+	case 0x03: return 0x13;   /* READ  -> 4READ */
+	case 0x02: return 0x12;   /* PP    -> 4PP   */
+	case 0x20: return 0x21;   /* SE    -> 4SE   */
+	case 0xD8: return 0xDC;   /* BE    -> 4BE   */
+	default:   return cmd;
+	}
+}
+
+/* 地址几个字节：低 16 MiB 用 3 字节（兼容所有芯片），再往上是 4 字节 */
+static size_t addr_bytes(uint32_t offset)
+{
+	return offset >= SPI_FLASH_16MB ? 4 : 3;
+}
+
+static size_t emit_addr(uint8_t *buf, size_t idx, uint32_t offset, size_t n)
+{
+	if (n == 4)
+		buf[idx++] = offset >> 24;
+	buf[idx++] = offset >> 16;
+	buf[idx++] = offset >> 8;
+	buf[idx++] = offset;
+	return idx;
+}
+
