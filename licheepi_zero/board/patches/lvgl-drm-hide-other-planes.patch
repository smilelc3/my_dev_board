+/* 查任意对象的属性 id（drm_dev->plane_props 里缓存的只是我们自己那个 plane 的） */
+static uint32_t drm_object_prop_id(int fd, uint32_t obj_id, uint32_t obj_type, const char * name)
+{
+    uint32_t i;
+    uint32_t id = 0;
+    drmModeObjectPropertiesPtr props = drmModeObjectGetProperties(fd, obj_id, obj_type);
+    if(!props) return 0;
+    for(i = 0; i < props->count_props; i++) {
+        drmModePropertyPtr prop = drmModeGetProperty(fd, props->props[i]);
+        if(prop) {
+            if(!lv_strcmp(prop->name, name)) id = prop->prop_id;
+            drmModeFreeProperty(prop);
+            if(id) break;
+        }
+    }
+    drmModeFreeObjectProperties(props);
+    return id;
+}
+
+/* 关掉挂在同一个 CRTC 上的"别人的" plane。
+ * 本地补丁：板子上 fbcon 用的 DRM fbdev plane 一直挂在这个 CRTC 上、zpos 还比我们高，
+ * 结果 LVGL 画在了它下面 —— 屏幕上看到的还是 tty。这里在首次（带 ALLOW_MODESET 的）
+ * 提交里把其它 plane 的 CRTC_ID/FB_ID 置 0，屏幕就归我们了。 */
+static void drm_disable_other_planes(drm_dev_t * drm_dev)
+{
+    uint32_t i;
+    drmModePlaneResPtr planes = drmModeGetPlaneResources(drm_dev->fd);
+    if(!planes) return;
+    for(i = 0; i < planes->count_planes; i++) {
+        uint32_t plane_id = planes->planes[i];
+        if(plane_id == drm_dev->plane_id) continue;
+        drmModePlanePtr plane = drmModeGetPlane(drm_dev->fd, plane_id);
+        if(!plane) continue;
+        if(plane->crtc_id == drm_dev->crtc_id) {
+            uint32_t crtc_prop = drm_object_prop_id(drm_dev->fd, plane_id, DRM_MODE_OBJECT_PLANE, "CRTC_ID");
+            uint32_t fb_prop = drm_object_prop_id(drm_dev->fd, plane_id, DRM_MODE_OBJECT_PLANE, "FB_ID");
+            if(crtc_prop) drmModeAtomicAddProperty(drm_dev->req, plane_id, crtc_prop, 0);
+            if(fb_prop) drmModeAtomicAddProperty(drm_dev->req, plane_id, fb_prop, 0);
+            LV_LOG_INFO("drm: hid plane %u on crtc %u (local patch)", plane_id, drm_dev->crtc_id);
+        }
+        drmModeFreePlane(plane);
+    }
+    drmModeFreePlaneResources(planes);
+}
