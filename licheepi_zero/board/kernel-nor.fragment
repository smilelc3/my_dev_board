# LicheePi Zero Dock / V3s / 32 MiB SPI NOR —— 内核配置片段
# 基线 sunxi_defconfig，由 04-kernel.sh 用 merge_config.sh 合并。
# 注意：`# CONFIG_x is not set` 后面不能跟注释，否则整行被静默忽略。

# ---------- 存储：SPI NOR / MTD / UBI / UBIFS ----------
CONFIG_MTD=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_SPI_NOR=y
# CONFIG_MTD_SPI_NOR_USE_4K_SECTORS is not set   # UBI 按 64 KiB PEB 处理
CONFIG_SPI=y
CONFIG_SPI_SUN6I=y
CONFIG_DMADEVICES=y
CONFIG_DMA_SUN6I=y
CONFIG_MTD_UBI=y
CONFIG_UBIFS_FS=y
CONFIG_UBIFS_FS_ZLIB=y
CONFIG_UBIFS_FS_LZO=y

# ---------- 文件系统 ----------
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# ---------- 显示：DE1 -> mixer0 -> TCON0 -> 480x272 RGB666 面板 ----------
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# FB_DEVICE 默认值跟随 CONFIG_FB，下面裁掉 FB 后必须显式打开，
# 否则没有 /dev/fb0（fbcon 不依赖它，症状是"屏幕有字但没有 /dev/fb0"）
CONFIG_FB_DEVICE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM=y
CONFIG_PWM_SUN4I=y

# ---------- 触摸：NS2009 在 I2C0（PENIRQ 未接 SoC，实际不可用）----------
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MV64XXX=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_TSC2007=y

# ---------- 以太网（Dock 板载 RJ45 / V3s 内置 PHY）----------
CONFIG_STMMAC_ETH=y
CONFIG_DWMAC_SUN8I=y
CONFIG_DWMAC_GENERIC=y

# ---------- USB：OTG 口做 gadget 串口控制台，USB-A 口做主机 ----------
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_GADGET=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_G_SERIAL=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

# ---------- 串口 ----------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_8250_CONSOLE=y

# ---------- 其它小件 ----------
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
CONFIG_WATCHDOG=y
CONFIG_SUNXI_WATCHDOG=y
CONFIG_PINCTRL_SUNXI=y
CONFIG_GPIO_SYSFS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_SUNXI=y
CONFIG_PRINTK_TIME=y
CONFIG_PANIC_TIMEOUT=5

# ---------- 裁剪：最小化（关掉用不到的大块）----------
